# =========================
# Datos locales y regenerables
# =========================
# Conservamos en Git la estructura completa de data/. Solo se ignora el
# contenido regenerable de cachés, resultados y carpetas de vídeos.
/data/cache/**/*
!/data/cache/**/
!/data/cache/**/.gitkeep

/data/outputs/**/*
!/data/outputs/**/
!/data/outputs/**/.gitkeep

/data/indexes/**/*
!/data/indexes/**/
!/data/indexes/**/.gitkeep

/data/models/**/*
!/data/models/**/
!/data/models/**/.gitkeep

/data/state/**/*
!/data/state/**/
!/data/state/**/.gitkeep

/data/**/videos/**/*
!/data/**/videos/**/
!/data/**/videos/**/.gitkeep

tmp/
temp/


# =========================
# Logs
# =========================
*.log


