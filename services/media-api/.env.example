# Selección del transporte: auto prueba Docker y usa local como alternativa.
HERMES_MODE=auto
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_DOCKER_WORKDIR=/workspace
# Hermes WebUI: mantiene sincronizado su selector global de razonamiento.
HERMES_WEBUI_URL=http://127.0.0.1:8787

# Solo son necesarios para el modo local si Hermes no está en la ruta predeterminada.
HERMES_AGENT_DIR=
HERMES_PYTHON=

# Rutas compartidas y locales. Vacías usan <repo>/shared y <repo>/data.
MEDIA_SHARED_DIR=
MEDIA_DATA_DIR=
MEDIA_WEB_DATA=

# Dashboard de gasto (solo backend). En local también se leen las claves de
# services/media-core/.env; en Docker pásalas como variables al servicio API.
OPENROUTER_API_KEY=
FAL_ADMIN_KEY=
REPLICATE_API_KEY=
# Tarifa usada para estimar WhisperX sobre A100 80GB; puede ajustarse sin código.
REPLICATE_A100_80GB_USD_PER_SECOND=0.0014
REPLICATE_QWEN_TTS_USD_PER_1000_CHARS=0.02
# Se sirve el último snapshot al instante y se actualiza en segundo plano.
PROVIDER_COST_CACHE_SECONDS=300
