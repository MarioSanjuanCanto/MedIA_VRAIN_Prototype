OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it
REPLICATE_API_KEY=
REPLICATE_MODEL=victor-upmeet/whisperx:655845d6190ef70573c669245f245892cd039df4b880a1e3a65852c09252f5cc
REPLICATE_QWEN_TTS_USD_PER_1000_CHARS=0.02
HUGGINGFACE_ACCESS_TOKEN=
HF_TOKEN=
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=media_transcripts_v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_AUTO_INDEX=false

# Rutas compartidas y locales. Vacías usan <repo>/shared y <repo>/data.
MEDIA_SHARED_DIR=
MEDIA_DATA_DIR=

# Local CPU TTS; blank model directory uses data/models/tts
TTS_PROVIDER=piper

# Local microphone ASR: base is lighter on CPU; small improves recognition.
# Download explicitly: python -m media_core.services.local_voice --download
VOICE_WHISPER_MODEL=base
VOICE_WHISPER_THREADS=2
PIPER_MODEL_DIR=
PIPER_THREADS=2
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8001
LLM_CACHE_TTL_SECONDS=86400
LLM_TIMEOUT_SECONDS=90

# Voz española de Piper; cambiar a es_ES-sharvard-medium para volver a la anterior
PIPER_VOICE_ES=es_ES-carlfm-x_low
